PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Keep true until you have live/sandbox Lenco credentials.
LENCO_MOCK=true
LENCO_SECRET_KEY=
LENCO_BASE_URL=https://api.lenco.co/access/v2

# Comma separated app origins for hosted deployments.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
